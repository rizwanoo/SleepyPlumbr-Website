# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CSRF_SECRET: Optional secret for HMAC-signed stateless CSRF tokens in server.ts.
CSRF_SECRET=""

# CONTACT_WEBHOOK_URL: Optional webhook URL for forwarding verified Columbia, MO service & education inquiries.
CONTACT_WEBHOOK_URL=""
